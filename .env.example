# --- Solana ---
# FIREPAD is mainnet-only. Use a mainnet-beta endpoint; the public endpoint is rate limited
# and does not support the agent's getProgramAccounts calls.
RPC_URL=

# Public base URL, used to build self-hosted metadata + image URLs and to check the
# domain in wallet sign-ins. REQUIRED in production. Keep it short: the metadata URI
# must fit in 200 bytes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: pin metadata JSON to IPFS via Pinata instead of self-hosting it.
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs

# --- Vanity mints ---
VANITY_SUFFIX=fire
# Max vanity addresses one wallet can take per hour.
VANITY_MAX_PER_HOUR=5
# Max per client IP per hour, and pool-wide per minute (stops wallet-farming scripts).
VANITY_MAX_PER_IP_HOUR=10
VANITY_MAX_PER_MINUTE=10
# Wallets need at least this much SOL to reserve an address (launch rent is ~0.02).
VANITY_MIN_BALANCE_SOL=0.02
# How many proxies sit in front of the app (picks the right X-Forwarded-For entry).
TRUSTED_PROXY_HOPS=1

# --- Admin panel (/admin) ---
# Comma-separated wallet addresses allowed to sign in.
ADMIN_WALLETS=
# Random 32+ char secret for signing admin session cookies, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# --- FIREAGENT payout agent (npm run fireagent) ---
# The agent wallet: the second shareholder on every coin, and where holder payouts come from.
NEXT_PUBLIC_FIREAGENT_WALLET=
# solana-keygen JSON keypair for that wallet (agent process only, never the web app).
FIREAGENT_KEYPAIR=
# Address lookup table so a launch with a first buy fits one transaction (npm run fireagent:lut).
FIREAGENT_LOOKUP_TABLE=
FIREAGENT_TICK_SECONDS=120
# Pay a coin's holders once its pool reaches this much SOL.
FIREAGENT_MIN_PAYOUT_SOL=0.05
# Only wallets holding at least this % of supply are paid (0.1 = 1M of 1B tokens); 0 pays everyone.
FIREAGENT_MIN_HOLD_PCT=0.1
# Largest holders paid per payout, and the smallest share worth a transfer.
FIREAGENT_MAX_HOLDERS=200
FIREAGENT_MIN_SHARE_SOL=0.0001
FIREAGENT_PRIORITY_MICROLAMPORTS=0

# --- Marketing agent (npm run marketing) ---
# Claude writes the Launch Kits and posts. Without it, built-in templates are used.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# Official FIREPAD account — X developer app with OAuth 1.0a user tokens (read + write).
# Without these the agent runs as a dry run (posts land in /admin → Marketing agent).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Creators' own X accounts — OAuth 2.0 client of the same X app. Callback URL to register in
# the X developer portal: <NEXT_PUBLIC_SITE_URL>/api/agent/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Encrypts stored creator X tokens (32+ chars). Defaults to ADMIN_SESSION_SECRET.
AGENT_SECRET=
AGENT_TICK_SECONDS=120
AGENT_OFFICIAL_PER_HOUR=8
AGENT_CREATOR_PER_HOUR=3
